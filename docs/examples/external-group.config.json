{
  "version": "domainry-identity-bridge-config-v2",
  "installation_id": "example-installation",
  "application_key": "example-application",
  "provider": {
    "key": "account-provider",
    "verification": {
      "kind": "http_introspection",
      "endpoint": "https://accounts.example.com/api/session/verify",
      "method": "POST",
      "timeout": "3s",
      "max_response_bytes": 65536,
      "credential": {
        "location": "header",
        "name": "Authorization",
        "prefix": "Bearer "
      },
      "response": {
        "subject_id": "/data/subject/id",
        "display_name": "/data/subject/name",
        "email": "/data/subject/email",
        "expires_at": "/data/expires_at",
        "expiry_format": "unix_seconds",
        "checks": [
          { "path": "/data/active", "equals": true },
          { "path": "/data/token_type", "equals": "access" },
          { "path": "/data/audience", "equals": "example-application" }
        ]
      }
    }
  },
  "workspace": {
    "mode": "per_external_group",
    "create_on_first_access": true,
    "name_template": "{{.ExternalWorkspaceName}}",
    "initial_role_keys": ["project_member"],
    "selector": {
      "location": "header",
      "name": "X-Group-ID"
    },
    "membership": {
      "kind": "http_membership_list",
      "endpoint": "https://accounts.example.com/api/groups",
      "method": "POST",
      "timeout": "3s",
      "max_response_bytes": 65536,
      "credential": {
        "location": "header",
        "name": "Authorization",
        "prefix": "Bearer "
      },
      "response": {
        "items": "/data/groups",
        "workspace_id": "/id",
        "workspace_name": "/name",
        "checks": [
          { "path": "/errCode", "equals": 0 }
        ]
      }
    }
  },
  "browser": {
    "display_name": "Accounts",
    "login_url": "https://accounts.example.com/login",
    "logout_url": "https://accounts.example.com/logout",
    "credential": {
      "location": "header",
      "name": "Authorization",
      "prefix": "Bearer "
    },
    "allowed_origins": ["https://app.example.com"]
  }
}
